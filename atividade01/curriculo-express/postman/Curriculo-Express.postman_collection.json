{
  "info": {
    "_postman_id": "cf5f4ea2-b7be-4c9e-93dd-0af16bf9e90e",
    "name": "Currículo Express — API REST (NeonDB + Vercel)",
    "description": "Coleção para avaliação da disciplina AOS. ATENÇÃO: troque baseUrl pela URL REAL gerada no Vercel. Primeiro execute Listar currículos para salvar pessoaId, e então os CRUDs. O projeto não é publicado automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Saúde e currículos (com relacionamentos)",
      "item": [
        {
          "name": "01. Verificar conexão com NeonDB",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API e Banco online\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().banco).to.eql(\"conectado\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Listar currículos (guarda pessoaId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/curriculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Existem pelo menos 2 currículos\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.at.least(2); });",
                  "if (pm.response.code === 200) {",
                  "  const pessoas = pm.response.json();",
                  "  if (pessoas[0]?.id) pm.collectionVariables.set(\"pessoaId\", pessoas[0].id);",
                  "  if (pessoas[1]?.id) pm.collectionVariables.set(\"pessoa2Id\", pessoas[1].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03. Consultar currículo completo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pessoas/{{pessoaId}}/curriculo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Currículo com relações 1:N\", () => { pm.response.to.have.status(200); const cv=pm.response.json(); [\"formacoes\",\"experiencias\",\"projetos\",\"habilidades\"].forEach(k=>pm.expect(cv[k],k).to.be.an(\"array\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Selecionar segunda pessoa (guarda pessoaId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pessoas/{{pessoa2Id}}/curriculo",
            "description": "Ao executar, a variável pessoaId passa a apontar para a segunda pessoa; abra Variables para conferir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Segunda pessoa encontrada\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.collectionVariables.set(\"pessoaId\",pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Pessoas",
      "item": [
        {
          "name": "Listar pessoas",
          "request": {
            "method": "GET",
            "header": [],
