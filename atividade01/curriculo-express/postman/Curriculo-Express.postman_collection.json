                  "pm.test(\"GET 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar pessoa de teste (guarda pessoaTesteId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/pessoas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pessoa de Teste Postman\",\n  \"email\": \"teste.{{$timestamp}}@example.com\",\n  \"cidade\": \"Recife - PE\",\n  \"resumo\": \"Registro temporário para testar o CRUD.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Retornou 201 e um UUID\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"pessoaTesteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pessoa por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pessoas/{{pessoaTesteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar pessoa de teste",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/pessoas/{{pessoaTesteId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cidade\": \"Olinda - PE\",\n  \"resumo\": \"Currículo atualizado com PUT.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Atualização 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir pessoa de teste",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/pessoas/{{pessoaTesteId}}",
            "description": "Exclua somente os registros temporários criados pelo Postman; não exclua os currículos de demonstração."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Exclusão confirmada (204)\", () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) pm.collectionVariables.unset(\"pessoaTesteId\");"
                ]
              }
            }
          ]
        }
      ]
